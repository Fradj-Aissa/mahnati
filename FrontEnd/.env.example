# متغيرات البيئة المطلوبة — انسخ هذا الملف وسمّه .env وأضف القيم الحقيقية

# PocketBase Backend URL (بدون علامات اقتباس)
VITE_POCKETBASE_URL=https://mahnati-api.onrender.com
POCKETBASE_URL=https://mahnati-api.onrender.com

# بيانات المشرف الأعلى على PocketBase
POCKETBASE_SUPERUSER_EMAIL=your_email@example.com
POCKETBASE_SUPERUSER_PASSWORD=your_password

# Supabase (اختياري)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
